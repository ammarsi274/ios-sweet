+static int
+write_sectors(uint64_t lba, uint32_t count, uint32_t buf_off)
+{
+	for (uint32_t i = 0; i < count; i++) {
+		int error = write_sector(lba + i, buf_off + i * SECTOR);
+		if (error) {
+			return error;
+		}
+	}
+	return 0;
