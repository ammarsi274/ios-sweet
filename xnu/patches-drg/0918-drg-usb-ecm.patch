drg: USB device mode with CDC-ECM networking on the Nokia (patch 0918)

drg_usb.c (USB device + CDC-ECM ifnet ue0 + live log, proven on the
other phone, compiled out by 0908) back in the build with this phone's
addresses (device tree / HMD gcc-sdm660.c): DWC3 0x0a800000, QSCRATCH
0x0a8f8800, QUSB2 v1 PHY 0x0c012000 (read only: PLL_STATUS 0x38,
PORT_POWERDOWN 0xb4, TUNE1/2 0x80/0x84), GCC usb30 master 0xf008, sleep
0xf00c, mock utmi 0xf010, cfg-noc axi 0x5018, aggre2 axi 0xf03c,
ahb2phy 0x6a004, clkref 0x8800c; GDSC 0xf004 unchanged. Probed from
drg_emmc_init after touch (as from the UFS init before). Boot-arg
drgusb: 0 off, 1 report only (default), 2 start the device.
research/reports/wifi-bt.md section 5.

diff --git a/bsd/conf/files b/bsd/conf/files
index 80ccf68..5fa4ca1 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -105,6 +105,7 @@ bsd/dev/random/randomdev.c		standard
 
 bsd/dev/memdev.c			standard
 bsd/dev/drg_emmc.c			standard
+bsd/dev/drg_usb.c			standard
 bsd/dev/drg_ts.c			standard
 bsd/kern/drg_perf.c			standard
 bsd/dev/drg_keys.c			standard
diff --git a/bsd/dev/drg_emmc.c b/bsd/dev/drg_emmc.c
index 011be68..c4f1fcb 100755
--- a/bsd/dev/drg_emmc.c
+++ b/bsd/dev/drg_emmc.c
@@ -654,6 +654,9 @@ drg_emmc_init(void)
 	drg_keys_init();
 	/* Nokia touch screen, brought up by the shim. */
 	drg_ts_init();
+	/* USB device + ECM networking (patch 0918; boot-arg drgusb) */
+	extern void drg_usb_probe(void);
+	drg_usb_probe();
 	return 0;
 }
 
diff --git a/bsd/dev/drg_usb.c b/bsd/dev/drg_usb.c
index 422ebff..18d36aa 100644
--- a/bsd/dev/drg_usb.c
+++ b/bsd/dev/drg_usb.c
@@ -2,9 +2,9 @@
  * DRG: USB bring-up, step 1 - read-only state probe.
  *
  * The phone's USB is a Synopsys DWC3 (USB 2.0 only, maximum-speed
- * high-speed) at 0x0a600000 behind Qualcomm's dwc-usb3-msm wrapper, with a
- * QUSB2 PHY at 0x088e2000; its power domain is the USB30_PRIM GDSC and its
- * clocks come from GCC (offsets from Linux gcc-sdmmagpie.c). ABL uses this
+ * high-speed) at 0x0a800000 behind Qualcomm's dwc-usb3-msm wrapper, with a
+ * QUSB2 v1 PHY at 0x0c012000; its power domain is the USB30_PRIM GDSC and its
+ * clocks come from GCC (offsets from HMD gcc-sdm660.c). ABL uses this
  * controller for fastboot; this probe only reports what state it is left
  * in after `fastboot boot`. It never writes a register, and it touches the
  * DWC3 / PHY register blocks only when the GCC status registers say their
@@ -51,18 +51,18 @@ static const struct {
 	const char *name;
 	uint32_t    off;
 } usb_cbcr[] = {
-	{ "master", 0x0f010 },
-	{ "sleep", 0x0f014 },
-	{ "utmi", 0x0f018 },
-	{ "cfg-noc-axi", 0x0502c },
-	{ "aggre-axi", 0x8201c },
+	{ "master", 0x0f008 },
+	{ "sleep", 0x0f00c },
+	{ "utmi", 0x0f010 },
+	{ "cfg-noc-axi", 0x05018 },
+	{ "aggre-axi", 0x0f03c },
 	{ "ahb2phy", 0x6a004 },
-	{ "clkref", 0x8c010 },
+	{ "clkref", 0x8800c },
 };
 
-#define DWC3_PA                 0x0a600000
+#define DWC3_PA                 0x0a800000
 #define DWC3_SIZE               0x0000d000
-#define QUSB2_PA                0x088e2000
+#define QUSB2_PA                0x0c012000
 #define QUSB2_SIZE              0x00000400
 
 static uint32_t
@@ -130,8 +130,8 @@ drg_usb_probe(void)
 	/* DT qcom,qusb-phy-reg-offset order (Linux phy-msm-qusb-v2.c): PORT_TUNE1 0x240,
 	 * PLL_COMMON_STATUS_ONE 0x1a0, PWR_CTRL1 0x210, INTR_CTRL 0x230,
 	 * PLL_CORE_INPUT_OVERRIDE 0x0a8, TEST1 0x254. */
-	printf("DRG USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
-	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x240), usb_rd(phy, 0x254));
+	printf("DRG USB: QUSB2 v1 PLL_STATUS 0x%08x PORT_POWERDOWN 0x%08x TUNE1 0x%08x TUNE2 0x%08x\n",
+	    usb_rd(phy, 0x38), usb_rd(phy, 0xb4), usb_rd(phy, 0x80), usb_rd(phy, 0x84));
 }
 
 /*
@@ -167,7 +167,7 @@ drg_usb_probe(void)
  * session; Linux dwc3-qcom forces that in software when the charger
  * reports a cable (dwc3_qcom_vbus_override_enable).
  */
-#define QSCRATCH_PA             0x0a6f8800
+#define QSCRATCH_PA             0x0a8f8800
 #define QSCRATCH_HS_PHY_CTRL    0x10
 #define   UTMI_OTG_VBUS_VALID   (1u << 20)
 #define   SW_SESSVLD_SEL        (1u << 28)
@@ -807,8 +807,9 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
  * so the boot is included. Nothing here may print (it would feed itself).
  * Boot-arg drgusblog=0 disables it.
  */
-extern uint32_t drg_log_copy(uint64_t *pos, char *out, uint32_t max);
-extern uint64_t drg_log_position(void);
+/* the live log ring lives in the other phone's drg_ufs.c, not built here: an empty log (no live log yet) */
+static uint32_t drg_log_copy(uint64_t *pos __unused, char *out __unused, uint32_t max __unused) { return 0; }
+static uint64_t drg_log_position(void) { return 0; }
 
 static void
 ud_log_thread(void *arg __unused, wait_result_t wr __unused)
