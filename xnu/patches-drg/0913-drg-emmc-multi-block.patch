+/*
+ * One run of count > 1 sectors between the card and DMA range offset
+ * buf_off: CMD18/CMD25 with Auto-CMD23 through one ADMA2 chain.
+ */
+static int
+issue_multi(const char *what, bool write, uint32_t lba, uint32_t count, uint32_t buf_off)
+{
+	volatile uint32_t *desc = (volatile uint32_t *)se.dma;
+	uint32_t bytes = count * SECTOR;
+	uint32_t n = (bytes + ADMA2_DESC_LEN - 1) / ADMA2_DESC_LEN;
+	uint64_t deadline;
+	uint32_t st = 0, r1 = 0;
+	int step;
+
+	nanoseconds_to_deadline(MULTI_TIMEOUT_NS, &deadline);
+	if (n * ADMA2_DESC_WORDS * 4 > DESC_BYTES || buf_off + bytes > se.dma_size) {
+		step = 0;
+		goto fail;
+	}
+	if (!wait_clear(HC_PRESENT, PRESENT_INHIBIT, deadline)) {
+		step = 1;
+		goto fail;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t len = i + 1 < n ? ADMA2_DESC_LEN : bytes - i * ADMA2_DESC_LEN;
+		uint64_t pa = se.dma_pa + buf_off + (uint64_t)i * ADMA2_DESC_LEN;
+		desc[ADMA2_DESC_WORDS * i] = (len << 16) | (i + 1 < n ? ADMA2_ATTR_TRAN : ADMA2_ATTR_TRAN_END);
+		desc[ADMA2_DESC_WORDS * i + 1] = (uint32_t)pa;
+		desc[ADMA2_DESC_WORDS * i + 2] = (uint32_t)(pa >> 32);
+	}
+	/* the descriptors and, for writes, the data must reach memory first */
+	__asm__ volatile("dsb sy" ::: "memory");
+
+	hc_wr(HC_INT_STATUS, 0xffffffffu);
+	hc_wr(HC_ADMA_ADDR_LO, (uint32_t)se.dma_pa);
+	hc_wr(HC_ADMA_ADDR_HI, (uint32_t)(se.dma_pa >> 32));
+	hc_wr(HC_ARGUMENT2, count);
+	hc_wr(HC_BLOCK, (count << 16) | SECTOR);
+	hc_wr(HC_ARGUMENT, lba);
+	hc_wr(HC_XFER_CMD, ((write ? CMD25 : CMD18) << 16) | XFER_MULTI_DMA | (write ? 0 : XFER_READ));
+
+	if (wait_int(INT_CMD_DONE, deadline, &st)) {
+		step = 2;
+		goto fail;
+	}
+	r1 = hc_rd(HC_RESPONSE0);
+	hc_wr(HC_INT_STATUS, INT_CMD_DONE);
+	if (wait_int(INT_XFER_DONE, deadline, &st)) {
+		step = 3;
+		goto fail;
+	}
+	hc_wr(HC_INT_STATUS, INT_XFER_DONE);
+	__asm__ volatile("dsb sy" ::: "memory");
+	if (r1 & R1_ERRORS) {
+		st = r1;
+		step = 4;
+		goto fail;
+	}
+	return 0;
+
+fail:
+	if (se.errors++ < 8) {
+		printf("DRG EMMC: %s 0x%x+%u failed at step %d: status 0x%08x present 0x%08x adma 0x%08x acmd 0x%04x\n",
+		    what, lba, count, step, st, hc_rd(HC_PRESENT), hc_rd(HC_ADMA_ERROR), hc_rd(HC_HOST_CTRL2) & 0xffff);
+	}
+	recover_lines();
+	return EIO;
+}
+
+/* After a failed run: CMD12 brings the card back to the transfer state (result not needed). */
+static void
+stop_transmission(void)
+{
+	(void)issue("stop", CMD12, 0, 0, 0, true, WRITE_TIMEOUT_NS, 0);
+}
