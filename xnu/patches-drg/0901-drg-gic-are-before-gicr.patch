drg: enable GIC affinity routing before configuring the redistributor

The Nokia 6.1 Plus ABL leaves GICD_CTLR = 0, unlike the board this
code came from (its ABL leaves ARE_NS set). pe_init_fiq() set ARE_NS
only after writing GICR_ISENABLER0, which is ignored for SGIs/PPIs
while affinity routing is off: the timer PPI stayed disabled and the
first boot hung in the first sleep after "entered initCPU". Turn ARE_NS
on first, as the shim did in its working GIC test.

diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -166,6 +166,22 @@
 
 #if defined(DRG)
 	/*
+	 * The Nokia 6.1 Plus ABL leaves GICD_CTLR = 0 (measured). GICR_IGROUPR0,
+	 * GICR_IPRIORITYR and GICR_ISENABLER0 only take effect for SGIs and PPIs
+	 * once affinity routing (ARE_NS) is on, so turn it on before configuring
+	 * this PE's redistributor. Otherwise the timer PPI stays disabled and the
+	 * first sleep never wakes up. ARE_NS may only change while the group
+	 * enables are off, which they are until the end of this function.
+	 */
+	uint32_t gicd_are = gicd_read32(GICD_CTLR);
+	if (!(gicd_are & GICD_CTLR_ARE_NS)) {
+		gicd_write32(GICD_CTLR, gicd_are | GICD_CTLR_ARE_NS);
+		while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+			;
+		}
+	}
+
+	/*
 	 * Real hardware with two security states: Group 0 is TrustZone's and
 	 * non-secure writes to it are ignored. Everything we own is Group 1 NS
 	 * and arrives as an IRQ (see sleh_irq). GICR_IGROUPR0 reads as zero
@@ -204,7 +220,7 @@
 	__builtin_arm_wsr64("ICC_CTLR_EL1", icc_ctlr);
 
 #if defined(DRG)
-	// ABL leaves only ARE_NS set; Linux writes ARE_NS | EnableGrp1A | EnableGrp1
+	// ARE_NS is on already (see above); enable Group 1 as Linux does
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
